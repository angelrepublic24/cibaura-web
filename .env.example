# ── Cibaura web — public build-time configuration ────────────────────────────
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at `next build`.
# Copy to `.env.local` for development and replace the URL placeholders. Production builds FAIL LOUDLY when a
# required value is missing (see src/lib/config.ts).

# Base URL of the Cibaura API (NestJS). No trailing slash; `/api` is appended
# automatically. REQUIRED. In production/staging the API must live under the
# SAME registrable domain as this site (e.g. https://cibaura.com +
# https://api.cibaura.com) — the session rides in SameSite=Lax httpOnly
# cookies, which browsers only attach same-site (ADR-0006).
NEXT_PUBLIC_API_URL=https://api.REPLACE_ME.invalid

# Public web origin for canonical, Open Graph, robots and sitemap. REQUIRED in
# production: HTTPS + real DNS hostname, no path. API_URL has the same rules.
# Missing/local/IP/example URLs fail production builds; no production bypass.
NEXT_PUBLIC_SITE_URL=https://web.REPLACE_ME.invalid

# Optional external public media origin/prefix, e.g. your CDN's /public/ prefix.
# API /api/cars/photos/* is already allowed. Other hosts load directly (unoptimized).
# Everything below this prefix can be optimized, including URLs with queries.
# Never set a private document or KYC prefix. Empty means only API photos are optimized.
NEXT_PUBLIC_MEDIA_URL=

# Stripe PUBLISHABLE key (pk_test_… / pk_live_…). REQUIRED wherever cards are
# saved: without it customers cannot add a card and therefore cannot book.
# Production builds refuse a pk_test_ key unless
# NEXT_PUBLIC_STRIPE_ALLOW_TEST_KEY=true (staging only).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_ALLOW_TEST_KEY=true

# Google Maps JavaScript API key (Places autocomplete for door-to-door
# delivery addresses). Required in production; native staging can explicitly
# opt out with ALLOW_MISSING_MAPS=true. That exception disables address delivery.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Legal identity rendered on /legal/terms and /legal/privacy. All FOUR fields
# are required in production. Fallbacks are for development/explicit staging only.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_RNC=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Required production build identity. Set from `git rev-parse HEAD` (40 hex).
# Release workflow supplies github.sha automatically; never a runtime override.
NEXT_PUBLIC_BUILD_SHA=
# Production requires all four legal fields and Maps. Native staging exceptions
# must be explicit; Docker/release does NOT forward these exception flags.
# ALLOW_DEFAULT_LEGAL=true
# ALLOW_MISSING_MAPS=true
# Optional build-time HTTP/CORS check of API /api/health (5 second timeout).
# BUILD_ENV_PROBE_API=true

# Standalone/container runtime only; cannot change embedded public values.
# PORT=3000
# HOSTNAME=0.0.0.0
# NEXT_TELEMETRY_DISABLED=1
# Compose-only host loopback port and image tag:
# WEB_HOST_PORT=3000
# WEB_IMAGE_TAG=local
# WEB_IMAGE_REPOSITORY=ghcr.io/OWNER/cibaura-web
# Optional build identity; release workflow sets these from tag/SHA.
# WEB_VERSION=unreleased
# WEB_REVISION=unknown
# Required by compose.production.yml, bare alternate hostname (no scheme/path).
# If SITE_URL uses the apex, set www.<domain>; if it uses www, set <domain>.
# Both hostnames need DNS to this VPS; Caddy issues certificates for both.
WEB_REDIRECT_HOST=www.REPLACE_ME.invalid
