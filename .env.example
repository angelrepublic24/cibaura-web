# ── Cibaura web — public build-time configuration ────────────────────────────
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at `next build`.
# Copy to `.env.local` for development. Production builds FAIL LOUDLY when a
# required value is missing (see src/lib/config.ts).

# Base URL of the Cibaura API (NestJS). No trailing slash; `/api` is appended
# automatically. REQUIRED. In production/staging the API must live under the
# SAME registrable domain as this site (e.g. https://cibaura.com +
# https://api.cibaura.com) — the session rides in SameSite=Lax httpOnly
# cookies, which browsers only attach same-site (ADR-0006).
NEXT_PUBLIC_API_URL=http://localhost:4300

# Stripe PUBLISHABLE key (pk_test_… / pk_live_…). REQUIRED wherever cards are
# saved: without it customers cannot add a card and therefore cannot book.
# Production builds refuse a pk_test_ key unless
# NEXT_PUBLIC_STRIPE_ALLOW_TEST_KEY=true (staging only).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# NEXT_PUBLIC_STRIPE_ALLOW_TEST_KEY=true

# Google Maps JavaScript API key (Places autocomplete for door-to-door
# delivery addresses). Optional: without it address delivery is unavailable
# and the UI says "Google Maps is not configured".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Legal identity rendered on /legal/terms and /legal/privacy. Neutral
# fallbacks apply when empty (see src/shared/config/legal.ts); set the real
# operator before launch. The RNC line is omitted when empty.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=Cibaura
NEXT_PUBLIC_LEGAL_RNC=
NEXT_PUBLIC_LEGAL_ADDRESS=Santo Domingo, Dominican Republic
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@cibaura.com
